# Copy to .env.local and fill with values from Supabase > Connect.
# Use the publishable key, never a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: Supabase Auth user UUID allowed to manage this portfolio.
# Separate multiple UUIDs with commas. An empty list denies admin access.
ADMIN_USER_IDS=
